# Ceph release to use, keep in sync with latest version supported
# by ceph-csi.
CEPH_IMAGE=quay.io/ceph/ceph:v20

# Must be a version that ROOK_VERSION supports.
KUBERNETES_VERSION=1.32.0
MINIKUBE_VERSION=1.38.0

# The version of rook to use, csi-op version is decided by rook
# and the csi version by the csi operator.
ROOK_VERSION=v1.21.0
